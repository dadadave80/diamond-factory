/// @title Diamond Factory
/// @author David Dada <daveproxy80@gmail.com> (https://github.com/dadadave80)
/// @notice Diamond factory that creates new diamonds with the same facets and initialization code
contract DiamondFactory is Diamond, Initializable {
    using LibInitializer for address;
    constructor(FacetCut[] memory _facetCuts, address _init, bytes memory _calldata)
        payable
        Diamond(_facetCuts, _init, _calldata)
    {}

    function initialize(address _diamond, address _owner) external payable initializer {
        _diamond._initialize(_owner);
    }
}
